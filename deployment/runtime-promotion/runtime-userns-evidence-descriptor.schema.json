{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/hermes-security-labs/deployment/runtime-promotion/runtime-userns-evidence-descriptor.schema.json",
  "title": "Runner runtime user-namespace evidence descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_status",
    "identity_descriptor",
    "user_namespace_relationship",
    "processes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runtime_status": {"const": "NOT_RUN"},
    "identity_descriptor": {
      "type": "string",
      "pattern": "^deployment/runtime-promotion/[A-Za-z0-9._/-]+\\.yaml$",
      "maxLength": 256
    },
    "user_namespace_relationship": {
      "enum": ["same", "different"]
    },
    "processes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "runner"],
      "properties": {
        "gateway": {"$ref": "#/$defs/processExpectation"},
        "runner": {"$ref": "#/$defs/processExpectation"}
      }
    }
  },
  "$defs": {
    "mapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inside_start", "outside_start", "length"],
      "properties": {
        "inside_start": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "outside_start": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "length": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "processExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "uid_map", "gid_map"],
      "properties": {
        "pid": {"type": "integer", "minimum": 2, "maximum": 2147483647},
        "uid_map": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/mapEntry"}
        },
        "gid_map": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/mapEntry"}
        }
      }
    }
  }
}
