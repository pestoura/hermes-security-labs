{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pestoura/hermes-security-labs/deployment/shared-vault-hsl/secret-zero-reconciliation.schema.json",
  "title": "HSL shared Vault Secret Zero sanitized reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issue", "change_record", "provider", "state",
    "observed_at", "consumer_cidr", "policy_metadata", "operator_result",
    "sanitization", "authority"
  ],
  "properties": {
    "schema_version": {"const": "hsl.shared-vault-secret-zero-reconciliation/v1"},
    "issue": {"const": 439},
    "change_record": {"const": "CHG-HSL-100"},
    "provider": {"const": "hermes-shared-vault"},
    "state": {"enum": ["NOT_RUN", "OBSERVED_PASS", "OBSERVED_FAIL"]},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "consumer_cidr": {"$ref": "#/definitions/ipv4_32"},
    "policy_metadata": {"$ref": "#/definitions/policy_metadata"},
    "operator_result": {
      "oneOf": [{"type": "null"}, {"$ref": "#/definitions/operator_result"}]
    },
    "sanitization": {"$ref": "#/definitions/sanitization"},
    "authority": {"$ref": "#/definitions/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "NOT_RUN"}}, "required": ["state"]},
      "then": {
        "properties": {
          "observed_at": {"type": "null"},
          "operator_result": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "OBSERVED_PASS"}}, "required": ["state"]},
      "then": {
        "properties": {
          "observed_at": {"type": "string", "format": "date-time"},
          "operator_result": {
            "allOf": [
              {"$ref": "#/definitions/operator_result"},
              {
                "properties": {
                  "issuance_completed": {"const": true},
                  "wrapped_delivery_created": {"const": true},
                  "unwrap_consumed_once": {"const": true},
                  "login_succeeded": {"const": true},
                  "positive_capability_probe_passed": {"const": true},
                  "negative_capability_checks_passed": {"const": true},
                  "no_secret_material_persisted": {"const": true}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "OBSERVED_FAIL"}}, "required": ["state"]},
      "then": {
        "properties": {
          "observed_at": {"type": "string", "format": "date-time"},
          "operator_result": {"$ref": "#/definitions/operator_result"}
        },
        "not": {
          "properties": {
            "operator_result": {
              "properties": {
                "issuance_completed": {"const": true},
                "wrapped_delivery_created": {"const": true},
                "unwrap_consumed_once": {"const": true},
                "login_succeeded": {"const": true},
                "positive_capability_probe_passed": {"const": true},
                "negative_capability_checks_passed": {"const": true},
                "no_secret_material_persisted": {"const": true}
              },
              "required": [
                "issuance_completed", "wrapped_delivery_created", "unwrap_consumed_once",
                "login_succeeded", "positive_capability_probe_passed",
                "negative_capability_checks_passed", "no_secret_material_persisted"
              ]
            }
          },
          "required": ["operator_result"]
        }
      }
    }
  ],
  "definitions": {
    "ipv4_32": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)[.]){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/32$"
    },
    "policy_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrap_ttl_seconds", "credential_ttl_seconds", "credential_num_uses",
        "credential_bound_cidr", "token_bound_cidr"
      ],
      "properties": {
        "wrap_ttl_seconds": {"const": 60},
        "credential_ttl_seconds": {"const": 120},
        "credential_num_uses": {"const": 1},
        "credential_bound_cidr": {"$ref": "#/definitions/ipv4_32"},
        "token_bound_cidr": {"$ref": "#/definitions/ipv4_32"}
      }
    },
    "operator_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuance_completed", "wrapped_delivery_created", "unwrap_consumed_once",
        "login_succeeded", "positive_capability_probe_passed",
        "negative_capability_checks_passed", "no_secret_material_persisted"
      ],
      "properties": {
        "issuance_completed": {"type": "boolean"},
        "wrapped_delivery_created": {"type": "boolean"},
        "unwrap_consumed_once": {"type": "boolean"},
        "login_succeeded": {"type": "boolean"},
        "positive_capability_probe_passed": {"type": "boolean"},
        "negative_capability_checks_passed": {"type": "boolean"},
        "no_secret_material_persisted": {"type": "boolean"}
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_credentials_present", "secret_values_present", "tokens_present",
        "private_keys_present", "passphrases_present"
      ],
      "properties": {
        "raw_credentials_present": {"const": false},
        "secret_values_present": {"const": false},
        "tokens_present": {"const": false},
        "private_keys_present": {"const": false},
        "passphrases_present": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_binding_allowed", "supplier_selection_effect", "signer_decision_effect",
        "promotion_allowed", "execution_authority", "runner_effect", "target_effect"
      ],
      "properties": {
        "trust_binding_allowed": {"const": false},
        "supplier_selection_effect": {"const": "NONE"},
        "signer_decision_effect": {"const": "NONE"},
        "promotion_allowed": {"const": false},
        "execution_authority": {"const": "NONE"},
        "runner_effect": {"const": false},
        "target_effect": {"const": false}
      }
    }
  }
}
