{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.io/schemas/api-pentest-runbook-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "mapping",
    "selectors",
    "risk",
    "inputs",
    "steps",
    "evaluation",
    "outputs"
  ],
  "properties": {
    "apiVersion": {
      "const": "hex0r.io/v1alpha1"
    },
    "kind": {
      "const": "ApiPentestRunbook"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "category",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^API-[A-Z0-9]+-[A-Z0-9-]+-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 5
        },
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owasp_api",
        "cwe"
      ],
      "properties": {
        "owasp_api": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwe": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CWE-[0-9]+$"
          }
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_types",
        "auth_types",
        "required_capabilities"
      ],
      "properties": {
        "api_types": {
          "type": "array",
          "items": {
            "enum": [
              "any",
              "rest",
              "graphql",
              "websocket",
              "soap",
              "grpc"
            ]
          }
        },
        "auth_types": {
          "type": "array",
          "items": {
            "enum": [
              "any",
              "none",
              "bearer",
              "jwt",
              "oauth2",
              "oidc",
              "cookie",
              "api_key",
              "basic",
              "mtls"
            ]
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intrusiveness",
        "production_safe",
        "destructive",
        "max_requests",
        "max_response_bytes"
      ],
      "properties": {
        "intrusiveness": {
          "enum": [
            "passive",
            "low",
            "medium",
            "high"
          ]
        },
        "production_safe": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "required",
          "secret"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "handler",
          "profile",
          "arguments",
          "timeout_seconds",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "const": "kali.action"
          },
          "handler": {
            "enum": [
              "http",
              "openapi",
              "tls",
              "nuclei",
              "sqlmap",
              "jwt",
              "graphql",
              "websocket",
              "fuzz",
              "race",
              "headers",
              "workflow"
            ]
          },
          "profile": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vulnerable_when",
        "secure_when",
        "inconclusive_when"
      ],
      "properties": {
        "vulnerable_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secure_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inconclusive_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "severity",
        "confidence"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical",
            "dynamic"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "dynamic"
          ]
        }
      }
    }
  }
}
