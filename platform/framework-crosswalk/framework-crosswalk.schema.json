{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/svp2-framework-crosswalk-1.0.json",
  "title": "SVP2 Framework Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "methodology_ref",
    "frameworks",
    "mappings",
    "runtime_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"const": "svp2-framework-crosswalk"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "methodology_ref": {"type": "string", "pattern": "^svp2-security-validation-methodology@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "frameworks": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/framework"}
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mapping"}
    },
    "runtime_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_external_sync",
        "automatic_framework_updates",
        "planner_consumer_integration",
        "reporting_consumer_integration",
        "execution_effect"
      ],
      "properties": {
        "authoritative_external_sync": {"const": "NOT_RUN"},
        "automatic_framework_updates": {"const": "NOT_IMPLEMENTED"},
        "planner_consumer_integration": {"const": "NOT_IMPLEMENTED"},
        "reporting_consumer_integration": {"const": "NOT_IMPLEMENTED"},
        "execution_effect": {"const": "NONE"}
      }
    }
  },
  "$defs": {
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_id",
        "framework_version",
        "title",
        "source_locator",
        "source_status"
      ],
      "properties": {
        "framework_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "framework_version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "pattern": "^https://"},
        "source_status": {"const": "manually_reviewed"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "phase_id",
        "framework_id",
        "target_ref",
        "target_label",
        "relation",
        "confidence",
        "confidence_score",
        "rationale",
        "advisory_only",
        "applicability"
      ],
      "properties": {
        "mapping_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "phase_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "framework_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "target_ref": {"type": "string", "minLength": 1},
        "target_label": {"type": "string", "minLength": 1},
        "relation": {"enum": ["aligned_with", "supports", "informed_by", "overlaps"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "confidence_score": {"type": "number", "minimum": 0.3, "maximum": 1.0},
        "rationale": {"type": "string", "minLength": 1},
        "advisory_only": {"const": true},
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domains"],
          "properties": {
            "domains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["general", "web_application"]}
            }
          }
        }
      }
    }
  }
}
