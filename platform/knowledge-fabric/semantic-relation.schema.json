{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/semantic-relation-v1.json",
  "title": "Security Knowledge Fabric Semantic Relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relation_id",
    "knowledge_snapshot_id",
    "relation_kind",
    "from_entity",
    "to_entity",
    "confidence",
    "provenance_record_ids",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "relation_id": {"type": "string", "pattern": "^sr_[a-f0-9]{32}$"},
    "knowledge_snapshot_id": {"type": "string", "pattern": "^ks_[a-f0-9]{32}$"},
    "relation_kind": {
      "enum": ["VULNERABILITY_TO_CWE", "CWE_TO_CAPEC", "CAPEC_TO_ATTACK"]
    },
    "from_entity": {"$ref": "#/$defs/entity"},
    "to_entity": {"$ref": "#/$defs/entity"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "provenance_record_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}
    },
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["vulnerability", "cwe", "capec", "attack"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
