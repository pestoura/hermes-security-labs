{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/semantic-relation-v1.json",
  "title": "Security Knowledge Fabric Semantic Relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relation_id",
    "knowledge_snapshot_id",
    "relation_kind",
    "from_entity",
    "to_entity",
    "confidence",
    "provenance_record_ids",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "relation_id": {"type": "string", "pattern": "^sr_[a-f0-9]{32}$"},
    "knowledge_snapshot_id": {"type": "string", "pattern": "^ks_[a-f0-9]{32}$"},
    "relation_kind": {
      "enum": ["VULNERABILITY_TO_CWE", "CWE_TO_CAPEC", "CAPEC_TO_ATTACK"]
    },
    "from_entity": {"$ref": "#/$defs/entity"},
    "to_entity": {"$ref": "#/$defs/entity"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "provenance_record_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}
    },
    "rationale": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"relation_kind": {"const": "VULNERABILITY_TO_CWE"}}},
      "then": {
        "properties": {
          "from_entity": {"$ref": "#/$defs/vulnerability"},
          "to_entity": {"$ref": "#/$defs/cwe"}
        }
      }
    },
    {
      "if": {"properties": {"relation_kind": {"const": "CWE_TO_CAPEC"}}},
      "then": {
        "properties": {
          "from_entity": {"$ref": "#/$defs/cwe"},
          "to_entity": {"$ref": "#/$defs/capec"}
        }
      }
    },
    {
      "if": {"properties": {"relation_kind": {"const": "CAPEC_TO_ATTACK"}}},
      "then": {
        "properties": {
          "from_entity": {"$ref": "#/$defs/capec"},
          "to_entity": {"$ref": "#/$defs/attack"}
        }
      }
    }
  ],
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["vulnerability", "cwe", "capec", "attack"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "vulnerability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "vulnerability"},
        "id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"}
      }
    },
    "cwe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "cwe"},
        "id": {"type": "string", "pattern": "^CWE-[0-9]+$"}
      }
    },
    "capec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "capec"},
        "id": {"type": "string", "pattern": "^CAPEC-[0-9]+$"}
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "attack"},
        "id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}
      }
    }
  }
}
