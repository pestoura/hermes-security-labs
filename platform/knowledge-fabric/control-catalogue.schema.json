{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/control-catalogue-v1.json",
  "title": "Supplied NIST Control Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalogue_id", "provider", "catalogue_name", "catalogue_version", "published_at", "source_locator", "source_origin", "external_fetch", "controls"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalogue_id": {"type": "string", "pattern": "^ctrlcat_[a-f0-9]{32}$"},
    "provider": {"const": "NIST"},
    "catalogue_name": {"type": "string", "minLength": 1},
    "catalogue_version": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "source_locator": {"type": "string", "pattern": "^snapshot:"},
    "source_origin": {"const": "SUPPLIED_SNAPSHOT"},
    "external_fetch": {"const": "NOT_PERFORMED"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "title", "objective", "provenance_record_ids"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]+(\\([0-9]+\\))?$"},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "provenance_record_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}
        }
      }
    }
  }
}
