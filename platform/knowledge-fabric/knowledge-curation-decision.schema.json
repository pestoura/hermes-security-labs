{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/knowledge-curation-decision-v1.json",
  "title": "Knowledge Curation Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "schema_version", "case_id", "knowledge_snapshot_id", "decision_basis", "curator_id", "precedence_policy_id", "decision", "selected_source_record_id", "rationale", "decided_at", "automatic_resolution", "historical_rewrite", "effect", "execution_authority"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^kqdec_[a-f0-9]{32}$"},
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^kqcase_[a-f0-9]{32}$"},
    "knowledge_snapshot_id": {"type": "string", "pattern": "^ks_[a-f0-9]{32}$"},
    "decision_basis": {"enum": ["CURATOR", "PRECEDENCE_POLICY"]},
    "curator_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 3, "maxLength": 128}]},
    "precedence_policy_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 3, "maxLength": 128}]},
    "decision": {"enum": ["SELECT_ASSERTION", "DEFER", "REJECT_ALL"]},
    "selected_source_record_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}]},
    "rationale": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "automatic_resolution": {"const": false},
    "historical_rewrite": {"const": false},
    "effect": {"const": "KNOWLEDGE_CURATION_ONLY"},
    "execution_authority": {"const": "NONE"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision_basis": {"const": "CURATOR"}}},
      "then": {"properties": {"curator_id": {"type": "string", "minLength": 3}, "precedence_policy_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"decision_basis": {"const": "PRECEDENCE_POLICY"}}},
      "then": {"properties": {"curator_id": {"type": "null"}, "precedence_policy_id": {"type": "string", "minLength": 3}, "decision": {"const": "SELECT_ASSERTION"}, "selected_source_record_id": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}}}
    },
    {
      "if": {"properties": {"decision": {"const": "SELECT_ASSERTION"}}},
      "then": {"properties": {"selected_source_record_id": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}}}
    },
    {
      "if": {"properties": {"decision": {"enum": ["DEFER", "REJECT_ALL"]}}},
      "then": {"properties": {"selected_source_record_id": {"type": "null"}}}
    }
  ]
}
