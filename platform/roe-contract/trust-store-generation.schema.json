{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/trust-store-generation.schema.json",
  "title": "RoE Trust Store Generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generation_id", "sequence", "generated_at",
    "previous_generation_id", "trust_store_sha256", "keys", "source",
    "activation_effect", "authorization_effect", "execution_authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generation_id": {"type": "string", "pattern": "^tsg_[a-f0-9]{32}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "previous_generation_id": {"type": ["string", "null"], "pattern": "^tsg_[a-f0-9]{32}$"},
    "trust_store_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "state", "public_key_sha256", "not_before", "not_after"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "algorithm": {"enum": ["Ed25519", "ECDSA-P256-SHA256"]},
          "state": {"enum": ["active", "revoked", "retired"]},
          "public_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "not_before": {"type": ["string", "null"], "format": "date-time"},
          "not_after": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "source": {"const": "EXTERNAL_TRUST_STORE_SNAPSHOT"},
    "activation_effect": {"const": "NONE"},
    "authorization_effect": {"const": "NONE"},
    "execution_authority": {"const": "NONE"}
  }
}
