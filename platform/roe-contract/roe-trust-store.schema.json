{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/roe-trust-store-1.0.0.json",
  "title": "Hexor RoE Trust Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "store_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "state",
        "not_before",
        "not_after",
        "public_key_spki_base64"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "algorithm": {"enum": ["Ed25519", "ECDSA-P256-SHA256"]},
        "state": {"enum": ["active", "revoked"]},
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"},
        "public_key_spki_base64": {
          "type": "string",
          "minLength": 32,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
