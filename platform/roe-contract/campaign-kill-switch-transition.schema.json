{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/campaign-kill-switch-transition-1.0.0.json",
  "title": "Hexor Campaign Kill-Switch Transition Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "campaign_id",
    "evaluated_at",
    "source_state",
    "target_state",
    "decision",
    "codes",
    "kill_switch_scope",
    "kill_switch_campaign_id",
    "fail_closed",
    "state_effect",
    "authorization_effect",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {
      "type": "string",
      "pattern": "^cks_[a-f0-9]{32}$"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "source_state": {
      "enum": [
        "DRAFT",
        "AUTHORIZED",
        "READY",
        "RUNNING",
        "PAUSED",
        "STOPPING",
        "STOPPED",
        "COMPLETED",
        "ABORTED",
        "EXPIRED"
      ]
    },
    "target_state": {
      "enum": [
        "DRAFT",
        "AUTHORIZED",
        "READY",
        "RUNNING",
        "PAUSED",
        "STOPPING",
        "STOPPED",
        "COMPLETED",
        "ABORTED",
        "EXPIRED"
      ]
    },
    "decision": {
      "enum": [
        "TRANSITION_REQUIRED",
        "FAIL_CLOSED_TRANSITION_REQUIRED",
        "NO_TRANSITION_REQUIRED"
      ]
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "kill_switch_scope": {
      "type": ["string", "null"],
      "enum": ["global", "campaign", null]
    },
    "kill_switch_campaign_id": {
      "type": ["string", "null"],
      "minLength": 3,
      "maxLength": 128
    },
    "fail_closed": {"type": "boolean"},
    "state_effect": {"enum": ["RESTRICT_ONLY", "NONE"]},
    "authorization_effect": {"const": "NONE"},
    "execution_authority": {"const": "NONE"}
  }
}
