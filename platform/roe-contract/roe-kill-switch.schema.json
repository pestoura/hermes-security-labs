{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/roe-kill-switch-1.0.0.json",
  "title": "Hexor RoE Kill Switch State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "state": {"enum": ["armed", "engaged"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "reason_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
    }
  }
}
