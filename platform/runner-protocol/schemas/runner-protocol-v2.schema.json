{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/pestoura/hermes-security-labs/platform/runner-protocol/schemas/runner-protocol-v2.schema.json","title":"Security Validation Platform Runner Protocol v2","description":"Canonical contract bundle for gateway-to-runner messages. The schema defines contract shape and does not itself grant authorization or claim runtime enforcement.","oneOf":[{"$ref":"#/$defs/step_request"},{"$ref":"#/$defs/progress_event"},{"$ref":"#/$defs/cancellation_request"},{"$ref":"#/$defs/cancellation_ack"},{"$ref":"#/$defs/outcome"}],"$defs":{"uuid":{"type":"string","format":"uuid"},"correlation":{"type":"object","additionalProperties":false,"required":["campaign_id","run_id","step_id","attempt_id"],"properties":{"campaign_id":{"$ref":"#/$defs/uuid"},"run_id":{"$ref":"#/$defs/uuid"},"step_id":{"$ref":"#/$defs/uuid"},"attempt_id":{"$ref":"#/$defs/uuid"}}},"evidence_reference":{"type":"object","additionalProperties":false,"required":["evidence_id","kind","classification","sha256"],"properties":{"evidence_id":{"$ref":"#/$defs/uuid"},"kind":{"type":"string","enum":["decision","protocol","execution","artifact","log","telemetry"]},"classification":{"type":"string","enum":["PUBLIC","INTERNAL","RESTRICTED"]},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"uri":{"type":"string","minLength":1,"maxLength":512}}},"normalized_error":{"type":"object","additionalProperties":false,"required":["code","category","retryable","message"],"properties":{"code":{"type":"string","enum":["INVALID_REQUEST","UNSUPPORTED_PROTOCOL_VERSION","UNSUPPORTED_CAPABILITY","AUTHORIZATION_DENIED","IDEMPOTENCY_CONFLICT","CANCELLED","TIMEOUT_SOFT","TIMEOUT_HARD","TRANSIENT_DEPENDENCY","RUNNER_UNAVAILABLE","EXECUTION_FAILED","EVIDENCE_MISSING","INTERNAL_ERROR"]},"category":{"type":"string","enum":["validation","compatibility","authorization","conflict","cancellation","timeout","dependency","execution","evidence","internal"]},"retryable":{"type":"bo