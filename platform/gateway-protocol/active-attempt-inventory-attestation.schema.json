{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/active-attempt-inventory-attestation.schema.json",
  "title": "Active Runner Attempt Inventory Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "trust_domain", "source_kind",
    "source_instance_id", "source_sequence", "issued_at", "expires_at",
    "previous_attestation_id", "inventory_id", "inventory_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "attestation_id": {"type": "string", "pattern": "^raiatt_[a-f0-9]{32}$"},
    "trust_domain": {"const": "RUNNER_SUPERVISOR_INVENTORY_ATTESTATION_V1"},
    "source_kind": {"const": "RUNTIME_SUPERVISOR"},
    "source_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "previous_attestation_id": {
      "type": ["string", "null"],
      "pattern": "^raiatt_[a-f0-9]{32}$"
    },
    "inventory_id": {"type": "string", "pattern": "^raiinv_[a-f0-9]{32}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm": {"enum": ["Ed25519", "ECDSA-P256-SHA256"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    }
  }
}
