{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/verified-runner-event-ref.schema.json",
  "title": "Verified Runner Event Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verification_id", "attestation_id", "message_type",
    "message_sha256", "source_instance_id", "source_sequence", "verified_at",
    "source_authenticity", "authorization_effect", "execution_authority",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "verification_id": {"type": "string", "pattern": "^rever_[a-f0-9]{32}$"},
    "attestation_id": {"type": "string", "pattern": "^revt_[a-f0-9]{32}$"},
    "message_type": {"enum": ["runner.cancellation.ack", "runner.outcome"]},
    "message_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_instance_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_sequence": {"type": "integer", "minimum": 1},
    "verified_at": {"type": "string", "format": "date-time"},
    "source_authenticity": {"const": "EXTERNALLY_VERIFIED"},
    "authorization_effect": {"const": "NONE"},
    "execution_authority": {"const": "NONE"},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
