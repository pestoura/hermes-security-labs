{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/hermes-security-labs/platform/gateway-protocol/gateway-request-v2.schema.json",
  "title": "Typed Security Gateway internal request v2",
  "description": "Internal typed-evaluation contract derived by the canonical admission boundary. Version 2 requires UUID correlation identifiers. The roe_decision field is internal derived state and is not accepted by the external admission schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "campaign_id",
    "run_id",
    "step_id",
    "attempt_id",
    "requested_at",
    "profile",
    "operation",
    "target",
    "roe_decision",
    "runtime_observation",
    "capability_attestations"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "campaign_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "step_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "requested_at": {"type": "string", "format": "date-time"},
    "profile": {"type": "string", "minLength": 1, "maxLength": 64},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "parameters"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "parameters": {"type": "object", "additionalProperties": true}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"type": "string", "enum": ["lab-asset", "cidr", "hostname", "url", "ip"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "roe_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "codes",
        "contract_id",
        "campaign_id",
        "step_request_id",
        "authorized_operation_id",
        "authorized_target_sha256",
        "contract_payload_sha256",
        "intrusiveness_ceiling"
      ],
      "properties": {
        "allowed": {"type": "boolean"},
        "codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "contract_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "campaign_id": {"type": "string", "format": "uuid"},
        "step_request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "authorized_operation_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "authorized_target_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contract_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "intrusiveness_ceiling": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"]}
      }
    },
    "runtime_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "canonical_root", "canonical_sha256", "observed_at"],
      "properties": {
        "state": {"type": "string", "enum": ["IN_SYNC", "DRIFT_DETECTED", "UNKNOWN"]},
        "canonical_root": {"const": "platform/registry.yaml"},
        "canonical_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "observed_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "capability_attestations": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  }
}
