{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/kill-switch-cancellation-plan.schema.json",
  "title": "Kill Switch In-Flight Cancellation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id", "schema_version", "inventory_id", "evaluated_at", "decision",
    "codes", "kill_switch_scope", "kill_switch_campaign_id", "fail_closed",
    "cancellation_requests", "already_cancelling_attempt_refs", "unaffected_attempt_refs",
    "dispatch_performed", "safety_effect", "authorization_effect", "execution_authority",
    "limitations"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^raicp_[a-f0-9]{32}$"},
    "schema_version": {"const": "1.0.0"},
    "inventory_id": {"type": "string", "pattern": "^raiinv_[a-f0-9]{32}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["CANCEL_REQUIRED", "NO_CANCELLATION_REQUIRED"]},
    "codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "kill_switch_scope": {"type": ["string", "null"], "enum": ["global", "campaign", null]},
    "kill_switch_campaign_id": {"type": ["string", "null"]},
    "fail_closed": {"type": "boolean"},
    "cancellation_requests": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_type", "protocol_version", "correlation", "emitted_at", "reason", "requested_by"],
        "properties": {
          "message_type": {"const": "runner.cancellation.request"},
          "protocol_version": {"const": "2.0.0"},
          "correlation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["campaign_id", "run_id", "step_id", "attempt_id"],
            "properties": {
              "campaign_id": {"type": "string", "format": "uuid"},
              "run_id": {"type": "string", "format": "uuid"},
              "step_id": {"type": "string", "format": "uuid"},
              "attempt_id": {"type": "string", "format": "uuid"}
            }
          },
          "emitted_at": {"type": "string", "format": "date-time"},
          "reason": {"const": "policy"},
          "requested_by": {"const": "gateway"}
        }
      }
    },
    "already_cancelling_attempt_refs": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^rai_[a-f0-9]{32}$"}},
    "unaffected_attempt_refs": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^rai_[a-f0-9]{32}$"}},
    "dispatch_performed": {"const": false},
    "safety_effect": {"const": "RESTRICT_ONLY"},
    "authorization_effect": {"const": "NONE"},
    "execution_authority": {"const": "NONE"},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "contains": {"const": "CANCELLATION_MESSAGES_BUILT_NOT_DISPATCHED"},
      "items": {"type": "string"}
    }
  }
}
