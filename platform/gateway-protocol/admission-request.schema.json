{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/gateway-admission-request-1.0.0.json",
  "title": "Hexor Typed Gateway Admission Request",
  "description": "Canonical admission input. It deliberately carries no caller-supplied RoE decision: the decision is derived internally from the signed contract, the RoE step request, the trust store and the external kill switch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "campaign_id",
    "run_id",
    "step_id",
    "attempt_id",
    "requested_at",
    "profile",
    "operation",
    "target",
    "runtime_observation",
    "capability_attestations",
    "roe_step_request_id",
    "contract_payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "enum": [
        "normal",
        "controlled"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "domain",
            "ip",
            "cidr",
            "uri-prefix",
            "lab-asset"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "runtime_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "canonical_root",
        "canonical_sha256",
        "observed_sha256",
        "observed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "IN_SYNC",
            "DRIFT_DETECTED",
            "UNKNOWN"
          ]
        },
        "canonical_root": {
          "const": "platform/registry.yaml"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "capability_attestations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
      }
    },
    "roe_step_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "contract_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
