{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/hermes-security-labs/platform/gateway-protocol/gateway-execution-outcome.schema.json",
  "title": "Typed Security Gateway Execution Outcome",
  "description": "Sanitized gateway-to-Hermes derivative of a validated Runner Protocol v2 terminal outcome. This contract carries no raw runner output, evidence URI, free-form runner error message or authorization grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_type",
    "runner_protocol_version",
    "correlation",
    "authorization_ref",
    "idempotency_key",
    "request_fingerprint",
    "request_envelope_sha256",
    "operation_id",
    "operation_version",
    "capability_id",
    "runner_status",
    "runner_emitted_at",
    "started_at",
    "finished_at",
    "evidence_refs",
    "output_present"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "message_type": {"const": "gateway.execution.outcome"},
    "runner_protocol_version": {"const": "2.0.0"},
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "run_id", "step_id", "attempt_id"],
      "properties": {
        "campaign_id": {"type": "string", "format": "uuid"},
        "run_id": {"type": "string", "format": "uuid"},
        "step_id": {"type": "string", "format": "uuid"},
        "attempt_id": {"type": "string", "format": "uuid"}
      }
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "operation_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capability_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "runner_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "ERROR", "CANCELLED", "TIMED_OUT", "INCONCLUSIVE", "REFUSED"]
    },
    "runner_emitted_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "classification", "sha256"],
        "properties": {
          "evidence_id": {"type": "string", "format": "uuid"},
          "kind": {
            "type": "string",
            "enum": ["decision", "protocol", "execution", "artifact", "log", "telemetry"]
          },
          "classification": {"type": "string", "enum": ["PUBLIC", "INTERNAL", "RESTRICTED"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "output_present": {"type": "boolean"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_PROTOCOL_VERSION",
            "UNSUPPORTED_CAPABILITY",
            "AUTHORIZATION_DENIED",
            "IDEMPOTENCY_CONFLICT",
            "CANCELLED",
            "TIMEOUT_SOFT",
            "TIMEOUT_HARD",
            "TRANSIENT_DEPENDENCY",
            "RUNNER_UNAVAILABLE",
            "EXECUTION_FAILED",
            "EVIDENCE_MISSING",
            "INTERNAL_ERROR"
          ]
        },
        "category": {
          "type": "string",
          "enum": ["validation", "compatibility", "authorization", "conflict", "cancellation", "timeout", "dependency", "execution", "evidence", "internal"]
        },
        "retryable": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"runner_status": {"const": "PASS"}}, "required": ["runner_status"]},
      "then": {"not": {"required": ["error"]}}
    },
    {
      "if": {
        "properties": {"runner_status": {"enum": ["ERROR", "TIMED_OUT", "REFUSED"]}},
        "required": ["runner_status"]
      },
      "then": {"required": ["error"]}
    }
  ]
}
