{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/content-candidate-v1.json",
  "title": "Continuous Content Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "kind", "source_events", "reuse_strategy", "lifecycle", "human_reviewed", "auto_merge", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^cc_[a-f0-9]{32}$"},
    "kind": {"enum": ["runbook", "lab", "runtime_image", "detection"]},
    "source_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reuse_strategy": {"enum": ["binding", "fixture", "variant", "new_content"]},
    "lifecycle": {"enum": ["PROPOSED", "REVIEWED", "LAB_VALIDATED", "CANDIDATE", "STABLE", "QUARANTINED", "RETIRED"]},
    "human_reviewed": {"type": "boolean"},
    "auto_merge": {"const": false},
    "duplicate_of": {"type": ["string", "null"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_delta", "positive_control", "negative_control", "reproducibility", "false_positive_rate", "false_negative_rate", "cost_delta", "staleness_days"],
      "properties": {
        "coverage_delta": {"type": "number"},
        "positive_control": {"type": "boolean"},
        "negative_control": {"type": "boolean"},
        "reproducibility": {"type": "number", "minimum": 0, "maximum": 1},
        "false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "false_negative_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "cost_delta": {"type": "number"},
        "staleness_days": {"type": "integer", "minimum": 0}
      }
    }
  }
}
