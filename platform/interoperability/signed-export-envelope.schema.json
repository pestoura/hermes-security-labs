{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/signed-export-envelope-v1.json",
  "title": "Controlled Signed Interoperability Export Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "format", "target_schema_id", "target_schema_version",
    "schema_validated", "data_markings", "payload_sha256", "payload", "signature",
    "execution_authority", "external_transport"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "format": {"enum": ["oscal-assessment-results", "oscal-poam", "cacao-2.0", "attack-flow"]},
    "target_schema_id": {"type": "string", "minLength": 1},
    "target_schema_version": {"type": "string", "minLength": 1},
    "schema_validated": {"const": true},
    "data_markings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {"type": "object"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "algorithm", "signer", "public_key_sha256", "value_b64"],
      "properties": {
        "verified": {"const": true},
        "algorithm": {"const": "Ed25519"},
        "signer": {"type": "string", "minLength": 1, "maxLength": 128},
        "public_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "value_b64": {"type": "string", "minLength": 80, "maxLength": 96}
      }
    },
    "execution_authority": {"const": "NONE"},
    "external_transport": {"const": "NOT_PERFORMED"}
  }
}
