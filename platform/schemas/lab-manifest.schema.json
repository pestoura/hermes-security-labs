{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hermes Security Labs environment manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "runtime",
    "status",
    "resources",
    "lifecycle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "string",
      "enum": ["docker", "kubernetes", "virtual-machine", "cloud", "emulator"]
    },
    "driver": {"type": "string"},
    "risk": {"type": "string"},
    "source": {"type": "string"},
    "version": {"type": ["string", "number"]},
    "resources": {"type": "object"},
    "networks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "egress": {"type": "boolean"},
    "targets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "attacker": {"type": "string"},
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["create", "start", "status", "smoke", "connect-kali", "disconnect-kali", "stop", "reset", "destroy"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reset": {"type": "string"},
    "cleanup": {"type": "string"},
    "evidence": {"type": "string"},
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "supported_tools": {
      "type": "array",
      "items": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": [
        "CURRENT",
        "CURRENT-LIMITED",
        "FUTURE-VM",
        "FUTURE-HARDWARE",
        "CLOUD-SANDBOX",
        "EXTERNAL-HARDWARE",
        "PLANNED"
      ]
    }
  },
  "additionalProperties": true
}
