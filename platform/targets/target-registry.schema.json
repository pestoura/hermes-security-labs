{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pestoura.github.io/hermes-security-labs/platform/targets/target-registry.schema.json",
  "title": "Hermes Security Labs canonical target registry",
  "description": "Canonical, fail-closed registry of executable targets. The target_id is the only execution authority; raw URLs, hostnames and IP addresses are never an execution authority on their own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "targets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_authority", "fail_closed", "offensive_execution_states"],
      "properties": {
        "canonical_authority": {
          "type": "string",
          "const": "target_id"
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        },
        "offensive_execution_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["LAB_ONLY", "AUTHORIZED_TEST_TARGET"]
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "environment_id",
        "kind",
        "identity",
        "authorization_state",
        "lifecycle",
        "health",
        "scope"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "minLength": 3,
          "maxLength": 96
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "kind": {
          "type": "string",
          "enum": ["network_service", "application"]
        },
        "description": { "type": "string" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "network", "reachability"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]*$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "protocol": {
              "type": "string",
              "enum": ["tcp", "udp"]
            },
            "scheme": {
              "type": "string",
              "enum": ["http", "https", "tcp", "graphql"]
            },
            "path": { "type": "string" },
            "network": { "type": "string" },
            "reachability": {
              "type": "string",
              "enum": ["lab-internal", "loopback"],
              "description": "Only internal or loopback reachability is representable. Public or externally routable identities are out of contract."
            }
          }
        },
        "authorization_state": {
          "type": "string",
          "enum": [
            "LAB_ONLY",
            "AUTHORIZED_TEST_TARGET",
            "UNVERIFIED",
            "BLOCKED",
            "EXTERNAL"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": ["PLANNED", "PROVISIONED", "ACTIVE", "SUSPENDED", "RETIRED"]
        },
        "health": {
          "type": "string",
          "enum": ["UNKNOWN", "HEALTHY", "DEGRADED", "UNHEALTHY"]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_operations"],
          "properties": {
            "allowed_operations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "discovery",
                  "service_enumeration",
                  "web_content_discovery",
                  "web_vulnerability_scan",
                  "api_schema_probe",
                  "manual_exploitation",
                  "authenticated_review",
                  "supply_chain_review"
                ]
              }
            },
            "denied_operations": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "notes": { "type": "string" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "manifest_path": { "type": "string" },
            "compose_path": { "type": "string" },
            "verified_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
