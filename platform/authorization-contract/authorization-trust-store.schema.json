{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/hermes-security-labs/platform/authorization-contract/authorization-trust-store.schema.json",
  "title": "TB1 Authorization Trust Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "purpose", "keys"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "domain": {"const": "hex0r.tb1.authorization.v1"},
    "purpose": {"const": "tb1-authorization"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "state", "purpose", "public_key"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "algorithm": {"type": "string", "enum": ["Ed25519", "ECDSA-P256-SHA256"]},
          "state": {"type": "string", "enum": ["active", "revoked", "retired"]},
          "purpose": {"const": "tb1-authorization"},
          "public_key": {"type": "string", "minLength": 1, "maxLength": 4096},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
