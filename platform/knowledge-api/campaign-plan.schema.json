{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexor.local/schemas/campaign-plan.schema.json",
  "title": "Knowledge-Driven Campaign Plan Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "campaign_id", "planning_context_id",
    "selected_steps", "excluded_candidates", "proposal_state", "executable",
    "planning_constraints_are_authorization", "authorization_effect",
    "requires_fresh_authorization", "execution_authority", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^kp_[a-f0-9]{32}$"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "planning_context_id": {"type": "string", "pattern": "^kpc_[a-f0-9]{32}$"},
    "selected_steps": {
      "type": "array", "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "operation_id", "capability_id", "intrusiveness_level", "asset_ids", "knowledge_record_ids", "confidence", "matched_technique_ids", "matched_vulnerability_ids", "selection_reason", "selection_rank"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^kpcand_[a-f0-9]{32}$"},
          "operation_id": {"type": "string", "minLength": 1},
          "capability_id": {"type": "string", "minLength": 1},
          "intrusiveness_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "asset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "knowledge_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "matched_technique_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "matched_vulnerability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "selection_reason": {"type": "string", "minLength": 1},
          "selection_rank": {"type": "integer", "minimum": 1}
        }
      }
    },
    "excluded_candidates": {
      "type": "array", "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "reasons"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^kpcand_[a-f0-9]{32}$"},
          "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "proposal_state": {"const": "PROPOSAL_ONLY"},
    "executable": {"const": false},
    "planning_constraints_are_authorization": {"const": false},
    "authorization_effect": {"const": "NONE"},
    "requires_fresh_authorization": {"const": true},
    "execution_authority": {"const": "CONTROL_PLANE_ONLY"},
    "limitations": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "contains": {"const": "PLAN_REQUIRES_FRESH_CONTROL_PLANE_AUTHORIZATION_BEFORE_EXECUTION"},
      "items": {"type": "string"}
    }
  }
}
