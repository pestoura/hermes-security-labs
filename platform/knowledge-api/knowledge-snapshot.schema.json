{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hex0r.local/schemas/knowledge-snapshot-v1.json",
  "title": "Security Knowledge Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "created_at", "source_record_ids", "snapshot_sha256", "immutable"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^ks_[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^kr_[a-f0-9]{32}$"}
    },
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "immutable": {"const": true}
  }
}
