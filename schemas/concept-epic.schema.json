{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/hermes-security-labs/schemas/concept-epic.schema.json",
  "title": "Security Validation Platform v2 concept epic catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "catalogue_id", "title", "source_of_truth", "delivery_backlog",
    "concept_count", "umbrella_count", "pillars", "phases", "concept_epics"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "catalogue_id": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "source_of_truth": { "type": "string", "minLength": 3 },
    "delivery_backlog": { "type": "string", "minLength": 3 },
    "concept_count": { "type": "integer", "const": 45 },
    "umbrella_count": { "type": "integer", "const": 21 },
    "pillars": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "enum": ["A","B","C","D","E","F","G","H","I","J","K","L"] },
          "name": { "type": "string", "minLength": 3 }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 8 },
          "name": { "type": "string", "minLength": 3 }
        }
      }
    },
    "concept_epics": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": { "$ref": "#/$defs/concept_epic" }
    }
  },
  "$defs": {
    "concept_epic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id", "slug", "title", "pillar", "phase", "priority", "status",
        "umbrella_id", "umbrella_issue", "dependencies", "doc_path",
        "current_state", "target_state"
      ],
      "properties": {
        "concept_id": { "type": "string", "pattern": "^EPIC-(0[1-9]|[1-3][0-9]|4[0-5])$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 8 },
        "pillar": { "type": "string", "enum": ["A","B","C","D","E","F","G","H","I","J","K","L"] },
        "phase": { "type": "integer", "minimum": 1, "maximum": 8 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "type": "string", "enum": ["intent", "implementing", "as_built", "final"] },
        "umbrella_id": { "type": "string", "pattern": "^SVP2-[A-L]-[0-9]{2}$" },
        "umbrella_issue": { "type": "integer", "minimum": 76, "maximum": 96 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EPIC-(0[1-9]|[1-3][0-9]|4[0-5])$" }
        },
        "doc_path": { "type": "string", "pattern": "^docs/roadmap/epics/EPIC-[0-9]{2}-[a-z0-9-]+\\.md$" },
        "current_state": { "type": "string", "minLength": 10 },
        "target_state": { "type": "string", "minLength": 10 }
      }
    }
  }
}
