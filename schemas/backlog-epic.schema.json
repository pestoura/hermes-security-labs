{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/hermes-security-labs/schemas/backlog-epic.schema.json",
  "title": "Security Validation Platform backlog",
  "type": "object",
  "required": ["schema_version", "backlog_id", "title", "source_of_truth", "pillars", "phases", "epics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "backlog_id": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "source_of_truth": { "type": "string", "minLength": 3 },
    "pillars": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"] },
          "name": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 10 }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 8 },
          "name": { "type": "string", "minLength": 3 }
        }
      }
    },
    "epics": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/epic" }
    }
  },
  "$defs": {
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "pillar", "priority", "phase", "status", "rationale",
        "scope", "deliverables", "dependencies", "acceptance_criteria",
        "effort", "risks", "labels", "references"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SVP2-[A-L]-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 8 },
        "pillar": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"] },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "phase": { "type": "integer", "minimum": 0, "maximum": 8 },
        "status": { "type": "string", "enum": ["proposed", "implementing", "completed"] },
        "rationale": { "type": "string", "minLength": 20 },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^SVP2-[A-L]-[0-9]{2}$" } },
        "acceptance_criteria": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 10 } },
        "effort": { "type": "string", "enum": ["S", "M", "L", "XL"] },
        "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "labels": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 } },
        "references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
      }
    }
  }
}
